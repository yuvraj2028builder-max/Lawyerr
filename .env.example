# NyayaSetu — Environment variables
# Copy to .env.local and fill. Never commit .env.local.
# All secrets must stay server-side. Nothing with VITE_ prefix should be a secret.

# Core
VITE_APP_NAME=NyayaSetu
VITE_DEFAULT_LANG=en

# Legal corpus (Prompt 2)
# VITE_LEGAL_CORPUS_MODE=test-fixture  # test-fixture | production
# VITE_LEGAL_SOURCES_URL=https://www.indiacode.nic.in  # only for primary official, verified via ingestion pipeline

# Future (not required for Prompt 2)
# VITE_API_BASE_URL=https://api.nyayasetu.in
# No Firebase/Supabase secrets in client bundle — they stay server-side
