# NyayaSetu — Environment variables
# Copy to .env.local and fill. Never commit .env.local.
# All secrets must stay server-side. Nothing with VITE_ prefix should be a secret.

# Core
VITE_APP_NAME=NyayaSetu
VITE_DEFAULT_LANG=en

# Legal corpus (Prompt 2)
# VITE_LEGAL_CORPUS_MODE=test-fixture  # test-fixture | production
# VITE_LEGAL_SOURCES_URL=https://www.indiacode.nic.in  # only for primary official, verified via ingestion pipeline

# Future (Prompt 13 — backend foundation, not connected)
# Public values only. NEVER put secrets here: no service-role keys, database
# passwords, Gemini API keys, signing secrets, or backend credentials.
# When these are absent the app honestly runs in local demo mode.
# VITE_BACKEND_ENABLED=1
# VITE_API_BASE_URL=https://api.nyayasetu.in
# Supabase (Prompt 15) — public values only. The anon key is public by design
# (RLS enforces privacy); the service-role key must NEVER appear here.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
# No Firebase/Supabase secrets in client bundle — they stay server-side
